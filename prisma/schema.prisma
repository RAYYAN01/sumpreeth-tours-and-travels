generator client {
  provider      = "prisma-client-js"
  // "native" for local dev; "rhel-openssl-3.0.x" for the Vercel Node runtime.
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// NOTE: enum-like columns are stored as plain strings, validated in
// src/lib/validation.ts; `Vehicle.features` / `Vehicle.images` are JSON string
// arrays (see src/lib/features.ts). String union types live in
// src/lib/constants.ts. This modelling came from the original SQLite schema
// and is kept unchanged on PostgreSQL for stability.
// ---------------------------------------------------------------------------

// Enquiries / leads captured from the public booking widget & contact form
model Enquiry {
  id             String   @id @default(cuid())
  name           String
  phone          String
  serviceType    String // ONE_WAY | ROUND_TRIP | AIRPORT | LOCAL | TOUR_PACKAGE
  pickupLocation String
  dropLocation   String?
  pickupAt       DateTime?
  message        String?
  status         String   @default("NEW") // NEW | CONTACTED | BOOKED | CLOSED
  adminNotes     String?
  sourcePage     String   @default("home")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([status])
  @@index([createdAt])
}

// Fleet
model Vehicle {
  id        String  @id @default(cuid())
  name      String
  slug      String  @unique @default("")
  category  String // CAR | TEMPO_TRAVELLER | BUS
  seats     String // e.g. "4+1", "12+1", "30-45"
  features  String  @default("[]") // JSON string array
  imageUrl  String // cover image
  images    String  @default("[]") // JSON string array of extra gallery images
  sortOrder Int     @default(0)
  isActive  Boolean @default(true)

  // When true, rates are hidden and a "Contact for quote" CTA is shown instead.
  quoteOnRequest Boolean @default(false)

  oneWayRate Int?
  oneWayNote String?

  roundTripPerKm Int?
  minKmPerDay    Int?
  driverBata     Int?
  roundTripNote  String?

  localPackageRate Int?
  localExtraPerKm  Int?
  localExtraPerHr  Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category, sortOrder])
}

// Destinations
model Destination {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  category    String // HILL_STATION | HERITAGE | PILGRIMAGE | NATURE_FALLS | MAJOR_CITY | OUTSTATION_GETAWAY
  description String
  imageUrl    String
  distanceKm  Int?
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([category, sortOrder])
}

// Testimonials
model Testimonial {
  id         String   @id @default(cuid())
  authorName String
  location   String
  rating     Int      @default(5)
  quote      String
  imageUrl   String?
  sortOrder  Int      @default(0)
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([sortOrder])
}

// FAQ
model FaqItem {
  id        String   @id @default(cuid())
  question  String
  answer    String
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sortOrder])
}

// Site settings (single row, id = "singleton")
model SiteSettings {
  id String @id @default("singleton")

  heroHeadline    String
  heroSubheadline String
  heroImageUrl    String

  aboutStory   String
  aboutPromise String

  trustYears  String
  trustTrips  String
  trustCities String

  ctaBannerText String

  phone          String
  whatsappNumber String
  email          String
  address        String
  hours          String
  mapEmbedUrl    String

  facebookUrl  String?
  instagramUrl String?
  youtubeUrl   String?

  adminId           String  @default("admin")
  adminPasswordHash String?

  updatedAt DateTime @updatedAt
}

// One-time password for the admin "forgot password" flow. Single row.
model AdminOtp {
  id        String   @id @default("singleton")
  codeHash  String
  expiresAt DateTime
  attempts  Int      @default(0)
  createdAt DateTime @default(now())
}
